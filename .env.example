# ─────────────────────────────────────
# 앱
# ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────
# 데이터베이스 (Supabase + Drizzle ORM)
# ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Drizzle ORM 연결 (Supabase 대시보드 > Settings > Database > Connection string)
# Transaction pooler (port 6543) — Cloudflare Workers 런타임용
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — drizzle-kit 마이그레이션용 (로컬에서만 사용)
DATABASE_URL_UNPOOLED=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ─────────────────────────────────────
# 인증 (NextAuth.js v5)
# ─────────────────────────────────────
AUTH_SECRET=                  # openssl rand -base64 32
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─────────────────────────────────────
# AI (Claude)
# ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────
# 캐시 (Upstash Redis)
# ─────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─────────────────────────────────────
# 개인정보 암호화
# ─────────────────────────────────────
ENCRYPTION_KEY=               # openssl rand -hex 32

# ─────────────────────────────────────
# 이메일 (Resend)
# ─────────────────────────────────────
RESEND_API_KEY=re_...

# ─────────────────────────────────────
# 결제 — Phase 2
# ─────────────────────────────────────
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ─────────────────────────────────────
# 모니터링
# ─────────────────────────────────────
SENTRY_DSN=
